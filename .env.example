# Copy this file to .env on the Raspberry Pi. The app reads it directly,
# including when started with sudo. Use the public Client ID, never the secret.
SPOTIFY_CLIENT_ID=your_32_character_client_id
# Optional if your GitHub Pages URL differs from the default below.
SPOTIFY_REDIRECT_URI=https://aymericschmid.github.io/led-matrix/spotify-callback.html

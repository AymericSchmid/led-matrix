# Copy this file to .env on the Raspberry Pi. The app reads it directly,
# including when started with sudo. For Spotify use the public Client ID, never its secret.
SPOTIFY_CLIENT_ID=your_32_character_client_id
# Optional if your GitHub Pages URL differs from the default below.
SPOTIFY_REDIRECT_URI=https://aymericschmid.github.io/led-matrix/spotify-callback.html

# Optional Sinric Pro integration: uncomment and replace all four together.
# Keep these credentials only in the ignored .env, never in public docs.
# SINRIC_APP_KEY=your-uuid-from-sinric
# SINRIC_APP_SECRET=your_sinric_secret_at_least_32_characters
# SINRIC_DEVICE_ID=your_24_hex_device_id
# SINRIC_SCENE_INSTANCE_ID=your_exact_mode_instance_id
